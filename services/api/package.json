{
  "name": "@agconn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --conditions=source --test \"src/**/*.test.ts\"",
    "test:db": "tsx --conditions=source --test --test-concurrency=1 \"src/**/*.db-test.ts\""
  },
  "dependencies": {
    "@agconn/api-client": "workspace:*",
    "@agconn/audit": "workspace:*",
    "@agconn/auth": "workspace:*",
    "@agconn/db": "workspace:*",
    "@agconn/email": "workspace:*",
    "@agconn/flc-verify": "workspace:*",
    "@agconn/llm": "workspace:*",
    "@agconn/reporting": "workspace:*",
    "@agconn/schemas": "workspace:*",
    "@agconn/sms": "workspace:*",
    "@azure/storage-blob": "12.34.0",
    "@clerk/backend": "^3.4.3",
    "@clerk/hono": "^0.1.22",
    "@hono/node-server": "^1.19.17",
    "@sentry/node": "10.76.2",
    "@wizeworks/lens-node": "0.3.0-alpha.10",
    "hono": "4.13.13",
    "pg-boss": "12.18.1",
    "stripe": "22.1.0",
    "svix": "1.92.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "6.0.3"
  }
}
