{
  "name": "agconn",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.9.0"
  },
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @agconn/web dev",
    "dev:api": "pnpm --filter @agconn/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && pnpm check:conventions",
    "typecheck": "pnpm -r typecheck && pnpm check:conventions",
    "check:conventions": "node scripts/check-tenant-id.mjs && node scripts/check-rls.mjs && node scripts/check-audit-required.mjs && node scripts/check-sms.mjs",
    "check:tenant-id": "node scripts/check-tenant-id.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:audit-required": "node scripts/check-audit-required.mjs",
    "check:sms": "node scripts/check-sms.mjs",
    "db:generate": "pnpm --filter @agconn/db db:generate",
    "db:push": "pnpm --filter @agconn/db db:push",
    "db:migrate:dev": "pnpm --filter @agconn/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @agconn/db db:migrate:deploy",
    "db:studio": "pnpm --filter @agconn/db db:studio",
    "email:dev": "pnpm --filter @agconn/email email:dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}\""
  },
  "pnpm": {
    "overrides": {
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "protobufjs@>=7.0.0 <7.6.5": "^7.6.5",
      "qs@>=6.0.0 <6.16.0": "^6.16.0",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "axios@>=1.0.0 <1.20.0": "^1.20.0",
      "js-cookie@>=3.0.0 <3.0.7": "^3.0.7",
      "tmp@>=0.2.0 <0.2.6": "^0.2.6",
      "esbuild@>=0.28.0 <0.28.1": "^0.28.1",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "dompurify@>=3.0.0 <3.4.17": "^3.4.17",
      "undici@>=6.0.0 <6.29.1": "^6.29.1",
      "@babel/core@>=7.0.0 <7.29.6": "^7.29.6",
      "fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "browserslist@>=4.0.0 <4.28.7": "^4.28.7",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "follow-redirects@>=1.0.0 <1.16.1": "^1.16.1",
      "@xmldom/xmldom@>=0.8.0 <0.8.15": "^0.8.15",
      "fflate@>=0.8.0 <0.8.3": "^0.8.3",
      "fflate@>=0.4.0 <0.4.9": "^0.4.9",
      "postcss@>=8.0.0 <8.5.23": "^8.5.23",
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "mysql2@>=3.0.0 <3.23.1": "^3.23.1",
      "valibot@>=1.0.0 <1.4.2": "^1.4.2",
      "@opentelemetry/core@>=2.0.0 <2.8.0": "^2.8.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "^2.11.0",
      "@hono/node-server@>=1.0.0 <1.19.17": "^1.19.17",
      "zod@>=4.0.0 <4.6.6": "^4.6.7",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "engine.io@>=6.0.0 <6.6.11": "^6.6.11",
      "socket.io-parser@>=4.0.0 <4.2.7": "^4.2.7"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    }
  }
}
